# Chỉ chứa giá trị mẫu. Sao chép thành .env rồi điền. Kiểm tra: drownctl doctor

# ===== ỨNG DỤNG =====
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# ===== POSTGRESQL DÙNG CHUNG (registry, job, khóa compute) =====
# postgresql+psycopg://USER:MẬT_KHẨU@HOST:5432/TÊN_DB?sslmode=require (sslmode khi DB ở máy khác)
DATABASE_URL=
# Neon: chuỗi KHÔNG pooler (host không có '-pooler'); hệ thống ưu tiên biến này nếu có
DATABASE_URL_UNPOOLED=
# database RIÊNG chỉ để chạy test, không bao giờ trùng DATABASE_URL
TEST_DATABASE_URL=
# để trống = tự sinh theo máy; nếu đặt thì mỗi máy một tên khác nhau
WORKER_ID=

# ===== GOOGLE DRIVE (lưu model, báo cáo, kết quả) =====
# đoạn cuối URL drive.google.com/drive/folders/<ID>
GOOGLE_DRIVE_FOLDER_ID=
# file OAuth client (Desktop app) tải từ Google Cloud
GOOGLE_OAUTH_CLIENT_SECRET_FILE=./secrets/google-oauth-client.json
# tạo bởi: drownctl auth drive
GOOGLE_OAUTH_TOKEN_FILE=./secrets/google-token.json

# ===== KAGGLE (train trên GPU; notebook luôn private) =====
# tên-kaggle/tên-notebook, ví dụ dung123/drowning-temporal
KAGGLE_KERNEL_REF=
# dataset PRIVATE gắn vào notebook: owner/slug, nhiều cái cách nhau bằng dấu phẩy
KAGGLE_DATASET_SOURCES=
# thư mục chứa kernel tạo cho từng job
KAGGLE_KERNEL_DIR=./notebooks/kernels
# giữ true; hệ thống từ chối push notebook công khai
KAGGLE_NOTEBOOK_PRIVATE=true
# cố định kaggle
TRAIN_DEFAULT_EXECUTOR=kaggle
# cố định false; không có train local
ALLOW_LOCAL_TRAIN=false
# một job compute trên toàn hệ thống
MAX_ACTIVE_COMPUTE_JOBS=1

# ===== TIẾN TRÌNH NỀN (tự gửi, theo dõi, khôi phục job Kaggle) =====
SUPERVISOR_ENABLED=true
SUPERVISOR_INTERVAL_SECONDS=30

# ===== MODEL VÀ CHẠY THỬ Ở MÁY NÀY =====
MODEL_FAMILY=drowning-person-temporal-v1
# cpu hoặc cuda
MODEL_DEVICE=cpu
# file trọng số detector người (.pt) có lớp 'person'; hệ thống không tự tải
PERSON_DETECTOR_WEIGHTS=
PERSON_DETECTOR_CLASS_ID=0
# nơi lưu model đã tải về
APPROVED_MODEL_BUNDLE_DIR=./local-cache/models/approved
MODEL_CACHE_DIR=./local-cache/models
INPUT_CACHE_DIR=./local-cache/inputs
OUTPUT_CACHE_DIR=./local-cache/results

# ===== THƯ MỤC DATASET GỐC TRÊN MÁY NÀY (chỉ đọc, dùng để duyệt/convert) =====
# dataset Alanoud v4 (ảnh)
ALANOUD_V4_DATA_ROOT=
UNIVERSITY_DATA_ROOT=
EXTRA_POOL_DATA_ROOT=
POOL_VIDEO_DATA_ROOT=
USER_VIDEO_DATA_ROOT=
